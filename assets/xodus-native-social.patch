+                    assert!(bytes.len() < 16384);
+                }
+                if status != 0 {
+                    let body = if status == 200 || status == 201 { r#"{"messageId":"synthetic-receipt","conversationId":"synthetic-thread"}"# } else { "PRIVATE_SERVER_ERROR" };
+                    write!(socket, "HTTP/1.1 {status} Test\r\nContent-Length: {}\r\nLocation: http://127.0.0.1:1/blocked\r\nConnection: close\r\n\r\n{body}", body.len()).unwrap();
