+        assert!(blocked_ids(&json!({"users":[{"xuid":"2"},{"xuid":"2"}]})).is_err());
+        assert_eq!(blocked_ids(&json!({"users":[]})).unwrap().len(),0);
+    }
+    #[test]fn recent_games_are_public_projection_with_numeric_titles_and_optional_achievement_data(){
+        let value=json!({"titles":[{"titleId":"00123","name":"Game","type":"Game","displayImage":"https://store-images.s-microsoft.com/image/apps/a",
+            "titleHistory":{"lastTimePlayed":"2026-10-23T12:34:56Z"},"achievement":{"currentAchievements":0,"totalAchievements":50,"currentGamerscore":10,"totalGamerscore":1000},"private":"DO_NOT_EXPOSE"}]});
+        let page=people_games(&value).unwrap();let row=&page["items"][0];assert_eq!(row["titleId"],"123");assert_eq!(row["achievementsUnlocked"],0);assert_eq!(row["achievementsTotal"],50);
+        assert!(row["imageUrl"].as_str().unwrap().starts_with("https://store-images.s-microsoft.com/"));assert!(!page.to_string().contains("DO_NOT_EXPOSE"));
+        let mut bad=value.clone();bad["titles"][0]["displayImage"]=json!("https://example.test/private");bad["titles"][0]["achievement"]=Value::Null;
+        let page=people_games(&bad).unwrap();assert!(page["items"][0].get("imageUrl").is_none());assert!(page["items"][0].get("currentGamerscore").is_none());
+        for id in ["4294967296","0","1/../../","123a"]{bad["titles"][0]["titleId"]=json!(id);assert!(people_games(&bad).is_err());}
+    }
+    #[test]fn gamer_pictures_are_bound_to_xbox_image_hosts_and_modern_tags_keep_their_suffix(){
+        let rows=friends(&json!({"people":[{"xuid":"2","modernGamertag":"Player","modernGamertagSuffix":"1234","displayPicRaw":"https://gamerpic.xboxlive.com/picture.png"}]})).unwrap();
+        assert_eq!(rows[0]["gamertag"],"Player#1234");assert_eq!(rows[0]["avatarUrl"],"https://gamerpic.xboxlive.com/picture.png");
+        let rows=friends(&json!({"people":[{"xuid":"2","gamertag":"Player","displayPicRaw":"https://example.test/private"}]})).unwrap();assert!(rows[0]["avatarUrl"].is_null());
+        assert!(wire(&json!({"id":1,"args":["profile","me"]})).is_ok());
+        assert!(wire(&json!({"id":1,"args":["profile","../me"]})).is_err());
+    }
+    #[test]fn profile_card_is_bound_to_the_selected_player_and_excludes_private_fields(){
+        let value=json!({"profileUsers":[{"id":"2","realName":"private","settings":[{"id":"Gamertag","value":"Player"},{"id":"Gamerscore","value":"12500"}]}]});
+        let result=player_profile(&value,"2").unwrap();assert_eq!(result["gamertag"],"Player");assert_eq!(result["gamerscore"],"12500");assert!(!result.to_string().contains("private"));
+        assert!(player_profile(&value,"1").is_err());assert!(player_profile(&json!({"profileUsers":[]}),"2").is_err());
+    }
+    use super::*;
+    #[test]fn private_wire_accepts_only_fixed_social_operations_and_requires_mutation_bodies(){
+        assert!(wire(&json!({"id":1,"args":["friends"],"input":null})).is_ok());
+        assert!(wire(&json!({"id":2,"args":["party"],"input":"{}"})).is_ok());
+        for args in [json!(["run","/arbitrary"]),json!(["listen"]),json!(["conversation","../me"]),json!([])]{
+            assert!(wire(&json!({"id":1,"args":args,"input":null})).is_err());
+        }
+        assert!(wire(&json!({"id":1,"args":["send-message"],"input":null})).is_err());
+        assert!(wire(&json!({"id":1,"args":["friends"],"input":"unexpected"})).is_err());
+    }
+    #[test]fn text_send_matches_the_shipped_contract_without_putting_content_in_the_url(){
+        let request=send_builder(&reqwest::Client::new(),"1","A private message").build().unwrap();
+        assert!(request.headers()["X-Xbl-ClientSeqNum"].to_str().unwrap().parse::<u64>().unwrap()>0);
+        assert!(!request.url().as_str().contains("private"));
+        assert_eq!(request.headers().get_all(reqwest::header::CONTENT_TYPE).iter().count(),1);
+        let body:Value=serde_json::from_slice(request.body().unwrap().as_bytes().unwrap()).unwrap();
+        assert_eq!(body,json!({"parts":[{"contentType":"text","version":0,"text":"A private message"}]}));
+    }
+    #[test]fn invitations_project_only_legitimate_multiplayer_actions_and_keep_chat_content_out(){
+        let value=json!({"items":[{"NotificationOptions":{"Location":{"Id":"6BE41AB5","Name":"E-Day"}},"Actions":[
+            {"SubscriptionCategory":"Microsoft.Xbox.Multiplayer","SubscriptionType":"PartyInvites","SubscriptionId":"notification-1","ActionTime":"2026-10-23T00:00:00Z",
+            "Actor":{"Id":"2","UniqueModernGamertag":"Friend","RealName":"private"},"LaunchInfo":{"mpsdHandleId":"invite-1","expirationTime":"2026-10-23T01:00:00Z"},"unused":"private"}]}]});
+        let rows=invites(&value).unwrap();assert_eq!(rows[0]["kind"],"party");assert_eq!(rows[0]["handle"],"invite-1");assert!(!rows[0].to_string().contains("private"));
+        assert!(invites(&json!({"items":[{"Actions":[{"SubscriptionCategory":"Other","SubscriptionType":"PartyInvites","private":"ignore"}]}]})).unwrap().is_empty());
+        assert!(invites(&json!({})).unwrap().is_empty());assert!(invites(&json!({"items":{}})).is_err());
+    }
+    #[test] fn accepts_only_bounded_recipient_ids_and_text() {
+        for bad in ["", "../me", "1)?url=https://evil", "18446744073709551616", "0"] {assert!(!xuid(bad));}
+        assert!(xuid("2533270000000001"));
+        assert!(send_request(&json!({"account":"account","xuid":"1","text":"Hi"})).is_ok());
+        for bad in [" ".to_string(),"x".repeat(257),"bad\u{0000}".to_string()] {
+            assert!(send_request(&json!({"account":"account","xuid":"1","text":bad})).is_err());
+        }
+    }
+    #[test] fn never_discloses_filtered_content_or_unused_profile_fields() {
+        let msg=message(&json!({"messageId":"id","sender":"1","timestamp":"now","contentPayload":{"content":{"parts":[
+            {"contentType":"text","text":"private filtered","unsuitableFor":["child"]}]}}}),"2").unwrap();
+        assert_eq!(msg["hidden"],true);assert!(!msg.to_string().contains("private filtered"));
+        let result=friends(&json!({"people":[{"xuid":"1","gamertag":"Player","realName":"Private Name","presenceState":"Online","presenceText":"Playing"}]})).unwrap();
+        assert_eq!(result[0]["online"],true);assert!(!result[0].to_string().contains("Private Name"));
+    }
+    #[test] fn malformed_service_payload_is_an_error_not_an_empty_social_graph() {
+        assert!(friends(&json!({})).is_err());assert!(inbox(&json!({}),"1").is_err());
+        assert!(friends(&json!({"people":[{"xuid":"../me","gamertag":"Player"}]})).is_err());
+        assert!(inbox(&json!({"primary":{"conversations":[{"conversationId":"x","participants":["bad"]}]}}),"1").is_err());
+    }
+    #[test] fn inbox_removes_self_and_recognizes_system_sender_zero() {
+        let rows=inbox(&json!({"primary":{"conversations":[
+            {"conversationId":"a","type":"OneToOne","participants":["1","2"]},
+            {"conversationId":"b","type":"OneToOne","participants":["0","1"]}]}}),"1").unwrap();
+        assert_eq!(rows[0]["participants"],json!(["2"]));assert_eq!(rows[1]["type"],"System");assert_eq!(rows[1]["gamertag"],"Xbox");
+    }
+}
diff --git a/crates/xodus-cli/src/commands/native_social_party.rs b/crates/xodus-cli/src/commands/native_social_party.rs
new file mode 100644
index 0000000..8eecc2c
--- /dev/null
+++ b/crates/xodus-cli/src/commands/native_social_party.rs
@@ -0,0 +1,191 @@
+//! Bounded party-service operations for the local Nexus voice controller.
+use serde_json::{Value,json};
+use base64::{Engine,prelude::BASE64_STANDARD_NO_PAD};
+use xodus::tokens::TokenManager;
+use super::profile::{bounded,xbox_session_identity};
+
+fn json_headers(request:reqwest::RequestBuilder)->reqwest::RequestBuilder{
+    let mut headers=reqwest::header::HeaderMap::new();
+    headers.insert(reqwest::header::CONTENT_TYPE,reqwest::header::HeaderValue::from_static("application/json"));
+    // .json() already inserts Content-Type; .header() would append a duplicate.
+    request.headers(headers)
+}
+
+fn id(value:&Value)->Result<&str,&'static str>{
+    value.as_str().filter(|s| !s.is_empty()&&s.len()<=128&&s.bytes().all(|b|b.is_ascii_alphanumeric()||b==b'-'||b==b'_')).ok_or("party-id")
+}
+fn short(value:&Value,max:usize)->Result<&str,&'static str>{
+    value.as_str().filter(|s|!s.is_empty()&&s.len()<=max&&!s.chars().any(char::is_control)).ok_or("party-field")
+}
+fn user_id(value:&Value)->Option<String>{
+    value.as_str().filter(|s|super::native_social::xuid(s)).map(str::to_owned)
+        .or_else(||value.as_u64().filter(|n|*n>0).map(|n|n.to_string()))
+}
+fn validate(input:&Value)->Result<&str,&'static str>{
+    short(&input["account"],512)?;
+    let op=input["operation"].as_str().ok_or("party-operation")?;
+    match op {
+        "active"=>(),
+        "get"|"leave"=>{id(&input["partyId"])?;},
+        "create"|"join"|"accept-invite"=>{
+            short(&input["connectionId"],512)?;short(&input["serverNonce"],4096)?;
+            let offer=input["offer"].as_str().filter(|s|s.len()<=128*1024).ok_or("party-offer")?;
+            let offer:Value=serde_json::from_str(offer).map_err(|_|"party-offer-json")?;
+            if offer["messageType"]!="transportConnectionRequestMessage" || offer["sdp"].as_str().is_none_or(|s|!s.starts_with("v=0\r\n")||s.len()>100*1024)
+                || offer["configuration"]["control"]["minVersion"]!=1 || offer["configuration"]["control"]["maxVersion"]!=1 {return Err("party-offer-shape");}
+            short(&offer["cv"],128)?;
+            if op=="join"{id(&input["partyId"])?;}
+            if op=="accept-invite"{id(&input["inviteId"])?;}
+        },
+        "invite"=>{id(&input["partyId"])?;if !input["xuid"].as_str().is_some_and(super::native_social::xuid){return Err("party-invite-xuid");}},
+        "voice-policy"=>{if !input["xuid"].as_str().is_some_and(super::native_social::xuid){return Err("voice-policy-xuid");}},
+        _=>return Err("party-operation"),
+    }
+    Ok(op)
+}
+fn document(value:&Value,self_xuid:&str)->Result<Value,&'static str>{
+    let session=id(&value["id"])?;
+    let rows=value["members"].as_array().filter(|a|a.len()<=128).ok_or("party-members")?;
+    let members:Result<Vec<Value>,&'static str>=rows.iter().map(|row|{
+        let xuid=user_id(&row["userId"]).ok_or("party-member-id")?;
+        Ok(json!({"xuid":xuid,"role":row["role"].as_str().filter(|s|s.len()<=64)}))
+    }).collect();
+    let own=rows.iter().find(|r|user_id(&r["userId"]).as_deref()==Some(self_xuid));
+    let answer=own.and_then(|r|r["connectionState"]["webRTC"]["transportConnectionResponse"].as_str())
+        .filter(|s|s.len()<=128*1024);
+    Ok(json!({"id":session,"owner":user_id(&value["owner"]),"members":members?,
+        "changeNumber":value["metadata"]["changeNumber"].as_u64(),"transportResponse":answer,
+        "joinability":value["joinability"].as_str().filter(|s|s.len()<=64)}))
+}
+fn default_region(value:&Value)->Result<String,&'static str>{
+    let regions=value["offeringSettings"]["regions"].as_array().filter(|a|a.len()<=128).ok_or("party-region-shape")?;
+    let region=regions.iter().find(|r|r["isDefault"]==true).ok_or("party-region-default")?;
+    region["name"].as_str().filter(|s|!s.is_empty()&&s.len()<=64&&s.bytes().all(|b|b.is_ascii_alphanumeric()||b==b'-'))
+        .map(str::to_owned).ok_or("party-region-name")
+}
+async fn relay_region(tokens:&TokenManager,expected_account:&str)->Result<String,&'static str>{
+    // The shipped party client uses the authenticated streaming service's default region.
+    let(client,authorization,account,_)=super::profile::xbox_session_for(tokens,"http://gssv.xboxlive.com/").await?;
+    if account!=expected_account{return Err("account-changed");}
+    let response=client.post("https://xgpuweb.gssv-play-prod.xboxlive.com/v2/login/user")
+        .json(&json!({"token":authorization,"offeringId":"xgpuweb"})).send().await.map_err(|_|"party-region-request")?;
+    if response.status().as_u16()==401{super::profile::invalidate_social_session(tokens);}
+    if !response.status().is_success(){return Err("party-region-http");}
+    let bytes=bounded(response,1024*1024).await?;
+    default_region(&serde_json::from_slice(&bytes).map_err(|_|"party-region-json")?)
+}
+pub(super) async fn request(tokens:&TokenManager,body:&str)->Result<Value,&'static str>{
+    if body.len()>160*1024{return Err("party-input-size");}
+    let input:Value=serde_json::from_str(body).map_err(|_|"party-input-json")?;
+    let operation=validate(&input)?;
+    let(client,authorization,account,self_xuid)=xbox_session_identity(tokens).await?;
+    if input["account"]!=account{return Err("account-changed");}
+    let self_xuid=self_xuid.filter(|s|super::native_social::xuid(s)).ok_or("xsts-user-id")?;
+    let session=if matches!(operation,"active"|"create"|"voice-policy"|"accept-invite"){""}else{id(&input["partyId"])?};
+    let region=if matches!(operation,"create"|"join"|"accept-invite"){Some(relay_region(tokens,&account).await?)}else{None};
+    let connection=||json!({"isBroadcasting":false,"allowedInBroadcast":false,"textToSpeechEnabled":false,
+        "chat":{"connectionId":input["connectionId"],"serverNonce":input["serverNonce"]},
+        "webRTC":{"transportConnectionRequest":input["offer"],"preferredRegion":region,"skipAllocation":false},"accessory":{"capabilities":0}});
+    let root="https://party.xboxlive.com";
+    let request=match operation{
+        "active"=>client.get(format!("{root}/users/xuid({self_xuid})/parties")),
+        "get"=>client.get(format!("{root}/parties/{session}/details")),
+        "create"=>{
+            // Preserve any party already active on another device. The UI must resolve it explicitly.
+            let response=client.get(format!("{root}/users/xuid({self_xuid})/parties")).header("Authorization",&authorization).send().await.map_err(|_|"party-active-request")?;
+            let bytes=bounded(response,128*1024).await?;
+            let active:Value=serde_json::from_slice(&bytes).map_err(|_|"party-active-json")?;
+            if !active.as_array().ok_or("party-active-shape")?.is_empty(){return Err("party-already-active");}
+            client.post(format!("{root}/parties/create")).json(&json!({"partyDetails":{"joinability":"inviteOnly"},"ownerConnection":connection()}))
+        },
+        "join"=>client.put(format!("{root}/parties/{session}/connection")).json(&connection()),
+        "accept-invite"=>client.put(format!("{root}/invites/{}/party/connection",id(&input["inviteId"])?)).json(&connection()),
+        "leave"=>client.post(format!("{root}/parties/{session}/leave")),
+        "invite"=>client.post(format!("{root}/parties/{session}/invite")).json(&json!({"inviteeXuids":[input["xuid"]]})),
+        "voice-policy"=>client.get(format!("https://privacy.xboxlive.com/users/xuid({self_xuid})/permission/validate?setting=CommunicateUsingVoice&target=xuid({})",input["xuid"].as_str().ok_or("voice-policy-xuid")?)).header("x-xbl-contract-version","2"),
+        _=>return Err("party-operation"),
+    };
+    let correlation=if let Some(offer)=input["offer"].as_str(){
+        serde_json::from_str::<Value>(offer).ok().and_then(|o|o["cv"].as_str().map(str::to_owned))
+    }else{None}.unwrap_or_else(||format!("{}.0",BASE64_STANDARD_NO_PAD.encode(uuid::Uuid::new_v4().as_bytes())));
+    let response=json_headers(request).header("Authorization",&authorization).header("MS-CV",correlation)
+        .header("X-WebRTCRelay-Alias","PartyWebRTC").send().await.map_err(|_|"party-request")?;
+    let status=response.status().as_u16();
+    if status==401{super::profile::invalidate_social_session(tokens);}
+    if !(200..=299).contains(&status){
+        eprintln!("NEXUS_SOCIAL_HTTP_DIAGNOSTIC_V1 party {status}");
+        // Service validation text only; remove every supplied connection/account secret first.
+        if status==400 {
+            let content_type=response.headers().get(reqwest::header::CONTENT_TYPE).and_then(|v|v.to_str().ok()).unwrap_or("none").to_owned();
+            let mut response=response;let mut body=Vec::new();
+            while let Some(chunk)=response.chunk().await.map_err(|_|"party-error-read")?{
+                if body.len()+chunk.len()>64*1024{return Err("party-error-size");}body.extend_from_slice(&chunk);
+            }
+            if body.len()<=64*1024 {
+                {
+                    let value=serde_json::from_slice::<Value>(&body).ok();
+                    let message=value.as_ref().and_then(|v|v["message"].as_str().or_else(||v["Message"].as_str()).or_else(||v["error"]["message"].as_str()))
+                        .map(str::to_owned).unwrap_or_else(||if body.is_empty(){format!("Empty error response; content type {content_type}")}else{String::from_utf8_lossy(&body).into_owned()});
+                    {
+                        let mut clean=message;
+                        for secret in [Some(account.as_str()),Some(self_xuid.as_str()),Some(authorization.as_str()),authorization.split(';').last(),input["connectionId"].as_str(),input["serverNonce"].as_str(),input["offer"].as_str()] {
+                            if let Some(secret)=secret.filter(|s|!s.is_empty()){clean=clean.replace(secret,"[redacted]");}
+                        }
+                        let clean=clean.split_whitespace().map(|word|if word.len()>64{"[redacted]"}else{word}).collect::<Vec<_>>().join(" ");
+                        let clean:String=clean.chars().filter(|c|!c.is_control()).take(1024).collect();
+                        eprintln!("NEXUS_SOCIAL_SERVICE_DIAGNOSTIC_V1 {}",json!({"message":clean}));
+                    }
+                }
+            }
+            return Err("party-http-status");
+        }
+    }
+    match status{
+        200..=299=>(),401|403=>return Err("party-permission-denied"),429=>return Err("party-rate-limited"),_=>return Err("party-http-status"),
+    }
+    let result=if matches!(operation,"leave"|"invite"){json!({"success":true})}else{
+        let bytes=bounded(response,1024*1024).await?;
+        let value:Value=serde_json::from_slice(&bytes).map_err(|_|"party-json")?;
+        match operation{
+            "active"=>{
+                let rows=value.as_array().filter(|a|a.len()<=16).ok_or("party-active-shape")?;
+                let sessions:Result<Vec<_>,_>=rows.iter().map(|v|id(&v["id"]).map(str::to_owned)).collect();json!({"ids":sessions?})
+            },
+            "voice-policy"=>json!({"isAllowed":value["isAllowed"].as_bool().ok_or("voice-policy-shape")?}),
+            _=>document(&value,&self_xuid)?,
+        }
+    };
+    if tokens.get_user().map_err(|_|"account-changed")?.username!=account{return Err("account-changed");}
+    Ok(json!({"schema":1,"kind":"party","account":account,"operation":operation,"result":result}))
+}
+
+#[cfg(test)]mod tests{
+    use super::*;
+    #[test]fn only_fixed_operations_and_safe_party_ids_are_accepted(){
+        assert!(validate(&json!({"account":"account","operation":"active"})).is_ok());
+        for op in ["https://evil.test/","update-profile","../../me"]{assert!(validate(&json!({"account":"account","operation":op})).is_err());}
+        for session in ["../me","a/b","bad?query","https://evil.test"]{assert!(validate(&json!({"account":"account","operation":"get","partyId":session})).is_err());}
+    }
+    #[test]fn relay_region_comes_from_the_authenticated_default_not_the_first_or_an_arbitrary_url(){
+        let value=json!({"gsToken":"must-not-escape","offeringSettings":{"regions":[
+            {"name":"OtherRegion","isDefault":false},{"name":"SelectedRegion","isDefault":true,"baseUri":"https://unused.test"}]}});
+        assert_eq!(default_region(&value).unwrap(),"SelectedRegion");
+        assert!(default_region(&json!({"offeringSettings":{"regions":[{"name":"https://evil.test","isDefault":true}]}})).is_err());
+        assert!(default_region(&json!({"offeringSettings":{"regions":[]}})).is_err());
+    }
+    #[test]fn json_content_type_is_sent_exactly_once(){
+        let client=reqwest::Client::new();
+        let request=json_headers(client.post("https://party.xboxlive.com/parties/create").json(&json!({"example":true}))).build().unwrap();
+        assert_eq!(request.headers().get_all(reqwest::header::CONTENT_TYPE).iter().count(),1);
+        assert_eq!(request.headers()[reqwest::header::CONTENT_TYPE],"application/json");
+    }
+    #[test]fn invalid_offer_is_rejected_before_authentication_or_party_creation(){
+        assert!(validate(&json!({"account":"account","operation":"create","connectionId":"c","serverNonce":"n","offer":"{}"})).is_err());
+    }
+    #[test]fn only_self_transport_and_selected_membership_fields_leave_the_backend(){
+        let value=json!({"id":"party-1","owner":1,"metadata":{"changeNumber":3,"extra":"private"},"members":[
+            {"userId":1,"role":"owner","connectionState":{"webRTC":{"transportConnectionResponse":"own-answer"}}},
+            {"userId":2,"connectionState":{"webRTC":{"transportConnectionResponse":"peer-private-answer"}}}]});
+        let result=document(&value,"1").unwrap();assert_eq!(result["transportResponse"],"own-answer");assert_eq!(result["members"][1]["xuid"],"2");assert!(!result.to_string().contains("peer-private-answer"));
+    }
+}
diff --git a/crates/xodus-cli/src/commands/native_social_session.rs b/crates/xodus-cli/src/commands/native_social_session.rs
new file mode 100644
index 0000000..4e74596
--- /dev/null
+++ b/crates/xodus-cli/src/commands/native_social_session.rs
@@ -0,0 +1,379 @@
+//! Outgoing chat uses the existing sign-in's real application/device context.
+//! Short-lived proof keys stay in memory. No interactive sign-in, registration,
+//! credential persistence, fabricated identity or automatic message retries.
+use chrono::{DateTime, Utc};
+use reqwest::{Client, RequestBuilder};
+use serde_json::{Value, json};
+use xodus::{models::{live::ExchangeUserTokenOutcome, secrets::Token, soap}, tokens::TokenManager,
+    xal::{RequestSigner, RequestSigning, RequestVerification, SignaturePolicyCache, oauth2::http}};
+
+const LIMIT: usize = 2 * 1024 * 1024;
+const MESSAGES: &str = "https://xblmessaging.xboxlive.com/network/Xbox/users/me/conversations/users/";
+const RP: &str = "http://xboxlive.com";
+const POLICY: &str = "https://title.mgt.xboxlive.com/titles/default/endpoints?type=1";
+const DEVICE: &str = "https://device.auth.xboxlive.com/device/authenticate";
+const SISU: &str = "https://sisu.xboxlive.com/authorize";
+const XSTS: &str = "https://xsts.auth.xboxlive.com/xsts/authorize";
+
+struct Session {
+    client: Client,
+    signer: RequestSigner,
+    authorization: String,
+    account: String,
+    principal: String,
+}
+
+fn account_unchanged(tokens: &TokenManager, account: &str, principal: &str) -> Result<(), &'static str> {
+    let Some((user, _)) = tokens.get_user_sts_session().map_err(|_| "account-changed")? else { return Err("account-changed"); };
+    if user.username != account || user.puid != principal { return Err("account-changed"); }
+    Ok(())
+}
+
+fn ticket(outcome: ExchangeUserTokenOutcome, now: DateTime<Utc>) -> Result<String, &'static str> {
+    if let Some(stage) = super::super::session::rejection(&outcome) { return Err(stage); }
+    let response = match outcome {
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponseCollection(mut values)) if values.security_tokens.len() == 1 => values.security_tokens.remove(0),
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(value)) => *value,
+        _ => return Err("chat-ticket-response"),
+    };
+    let created = DateTime::parse_from_rfc3339(&response.lifetime.created).map_err(|_| "chat-ticket-lifetime")?;
+    let expires = DateTime::parse_from_rfc3339(&response.lifetime.expires).map_err(|_| "chat-ticket-lifetime")?;
+    if expires <= now || expires <= created || created > now + chrono::Duration::minutes(5) { return Err("chat-ticket-lifetime"); }
+    let Token::Compact(value) = Token::try_from(response).map_err(|_| "chat-ticket-parse")? else { return Err("chat-ticket-type"); };
+    if value.is_empty() { return Err("chat-ticket-empty"); }
+    Ok(value)
+}
+
+fn fresh_token(value: &Value, now: DateTime<Utc>) -> Result<&str, &'static str> {
+    let expires = value["NotAfter"].as_str().and_then(|v| DateTime::parse_from_rfc3339(v).ok()).ok_or("chat-token-lifetime")?;
+    if expires <= now { return Err("chat-token-expired"); }
+    value["Token"].as_str().filter(|v| !v.is_empty()).ok_or("chat-token-empty")
+}
+
+fn authorization(value: Value, now: DateTime<Utc>) -> Result<String, &'static str> {
+    fresh_token(&value, now)?;
+    let claims = value["DisplayClaims"]["xui"].as_array().filter(|v| v.len() == 1).ok_or("chat-token-claims")?;
+    if !claims[0]["xid"].as_str().is_some_and(super::xuid) { return Err("chat-token-claims"); }
+    if !claims[0]["prv"].as_str().is_some_and(|v| v.split_ascii_whitespace().any(|v| v == "252")) {
+        return Err("privacy-or-access-denied");
+    }
+    let token = serde_json::from_value(value).map_err(|_| "chat-token-claims")?;
+    xodus::api::xbox::get_xsts_auth_header(token).map_err(|_| "chat-token-claims")
+}
+
+// XAL's pinned reqwest transport and the backend use different HTTP versions.
+// Its public reqwest overload preserves all headers, unlike its http::Request
+// overload. Type inference through verify selects that transport without adding
+// another dependency. Sign and verify the exact serialized bytes before sending.
+async fn signed(request: RequestBuilder, signer: &mut RequestSigner) -> Result<RequestBuilder, &'static str> {
+    let exact = request.try_clone().ok_or("chat-request-clone")?.build().map_err(|_| "chat-request-build")?;
+    let mut wire = http::Request::builder().method(exact.method().as_str()).uri(exact.url().as_str());
+    for (name, value) in exact.headers() { wire = wire.header(name.as_str(), value.as_bytes()); }
+    let body = exact.body().map(|v| v.as_bytes().ok_or("chat-request-body")).transpose()?.unwrap_or(&[]).to_vec();
+    let wire = wire.body(body).map_err(|_| "chat-request-build")?;
+    let legacy = wire.try_into().map_err(|_| "chat-request-build")?;
+    let signed = signer.sign_request(legacy, None).await.map_err(|_| "chat-request-signature")?;
+    let verified = signer.verify(signed).await.map_err(|_| "chat-request-signature")?;
+    let signature = verified.headers().get("Signature").and_then(|v| v.to_str().ok()).ok_or("chat-request-signature")?;
+    Ok(request.header("Signature", signature))
+}
+
+async fn response(response: reqwest::Response, stage: &'static str, created: bool) -> Result<Value, &'static str> {
+    let status = response.status().as_u16();
+    eprintln!("NEXUS_SOCIAL_DIAGNOSTIC_V1 {stage} {status}");
+    if status != 200 && !(created && status == 201) {
+        return Err(match status { 401 => "sign-in-required", 403 => "privacy-or-access-denied", 429 => "rate-limited", _ => "service-unavailable" });
+    }
+    serde_json::from_slice(&super::super::profile::bounded(response, LIMIT).await?).map_err(|_| "invalid-response")
+}
+
+async fn messaging_relying_party(cache: &mut SignaturePolicyCache) -> Result<Option<String>, &'static str> {
+    // The pinned XAL audience helper unconditionally prints endpoint details to
+    // stdout. Keep the same selection against the already fetched typed NSAL
+    // response, but reserve stdout for the one account-bound JSON result.
+    // Signing and verification still use the unmodified XAL policy cache.
+    let url = reqwest::Url::parse(MESSAGES).map_err(|_| "chat-policy-response")?;
+    let endpoints = cache.get_endpoints().ok_or("chat-policy-response")?;
+    Ok(endpoints.end_points.iter().filter(|endpoint| {
+        endpoint.protocol.eq_ignore_ascii_case(url.scheme())
+            && url.host_str().is_some_and(|host| match endpoint.host_type.as_str() {
+                "fqdn" => host.eq_ignore_ascii_case(&endpoint.host),
+                "wildcard" => host.ends_with(endpoint.host.trim_start_matches('*')),
+                _ => false,
+            })
+            && endpoint.path.as_ref().is_none_or(|path| url.path() == path)
+    }).max_by_key(|endpoint| endpoint.host.len()).and_then(|endpoint| endpoint.relying_party.clone()))
+}
+
+impl Session {
+    async fn new(tokens: &TokenManager, expected: &str) -> Result<Self, &'static str> {
+        let client = Client::builder().redirect(reqwest::redirect::Policy::none())
+            .timeout(super::super::session::REQUEST_TIMEOUT).user_agent("xodus-nexus-social/1").build().map_err(|_| "http-client")?;
+        let (account, device, user) = super::super::session::prepare(tokens, &client).await?;
+        // An outgoing write must use the actual account/ticket pair stored by
+        // sign-in, not independent legacy records that can belong to two sessions.
+        let Some((bound_user, Token::Legacy(bound_token))) = tokens.get_user_sts_session().map_err(|_| "sign-in-required")? else { return Err("sign-in-required"); };
+        if bound_user.username != account || bound_user.puid.is_empty() || bound_token.token != user.token { return Err("account-changed"); }
+        if account != expected { return Err("account-changed"); }
+        let principal = bound_user.puid;
+        let app = super::super::login::CLIENT_ID;
+        let scope = format!("scope=xboxlive.signin&api-version=2.0&clientid={app}");
+        let outcome = xodus::api::live::exchange_user_token(&client, user, account.clone(), device.clone(), None, Some("Silent".into()), app.into(),
+            &[(scope, Some(soap::PolicyReference::token_broker()))]).await.map_err(|_| "chat-ticket-request")?;
+        let user_ticket = ticket(outcome, Utc::now())?;
+        let device_response = xodus::api::live::exchange_device_token(&client, device,
+            "{28C08266-F973-4AE6-FFE4-409B249F138F}".into(),
+            "scope=service::user.auth.xboxlive.com::MBI_SSL&api-version=2.0".into(), Some(soap::PolicyReference::token_broker()))
+            .await.map_err(|_| "chat-device-ticket")?;
+        let device_ticket = ticket(ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(Box::new(device_response))), Utc::now())?;
+        let endpoints = response(client.get(POLICY).header("x-xbl-contract-version", "1").send().await.map_err(|_| "chat-policy-request")?, "chat-policy-http", false).await?;
+        let endpoints = serde_json::from_value(endpoints).map_err(|_| "chat-policy-response")?;
+        let mut signer = RequestSigner::new();
+        signer.signature_policy_cache = SignaturePolicyCache::new(endpoints);
+        let rp = messaging_relying_party(&mut signer.signature_policy_cache).await?
+            .ok_or("chat-policy-missing")?;
+        if rp != RP { return Err("chat-policy-audience"); }
+        let request = client.post(DEVICE).header("x-xbl-contract-version", "1").json(&json!({
+            "RelyingParty":"http://auth.xboxlive.com","TokenType":"JWT","Properties":{
+                "AuthMethod":"RPS","RpsTicket":device_ticket,"SiteName":"user.auth.xboxlive.com",
+                "Version":xodus::xal::client_params::CLIENT_WINDOWS().client_version,"ProofKey":signer.get_proof_key()}}));
+        let device = response(signed(request, &mut signer).await?.send().await.map_err(|_| "chat-device-request")?, "chat-device-http", false).await?;
+        let device_token = fresh_token(&device, Utc::now())?;
+        let request = client.post(SISU).json(&json!({"AccessToken":user_ticket,"AppId":app,"DeviceToken":device_token,
+            "Sandbox":"RETAIL","SiteName":"user.auth.xboxlive.com","ProofKey":signer.get_proof_key()}));
+        let sisu = response(signed(request, &mut signer).await?.send().await.map_err(|_| "chat-context-request")?, "chat-context-http", false).await?;
+        let user_token = fresh_token(&sisu["UserToken"], Utc::now())?;
+        let title_token = fresh_token(&sisu["TitleToken"], Utc::now())?;
+        let request = client.post(XSTS).header("x-xbl-contract-version", "1").json(&json!({
+            "RelyingParty":RP,"TokenType":"JWT","Properties":{
+                "SandboxId":"RETAIL","DeviceToken":device_token,"TitleToken":title_token,"UserTokens":[user_token]}}));
+        let xsts = response(signed(request, &mut signer).await?.send().await.map_err(|_| "chat-xsts-request")?, "chat-xsts-http", false).await?;
+        let authorization = authorization(xsts, Utc::now())?;
+        account_unchanged(tokens, &account, &principal)?;
+        Ok(Self { client, signer, authorization, account, principal })
+    }
+
+    async fn allowed(&mut self, peer: &str) -> Result<(), &'static str> {
+        let mut url = reqwest::Url::parse("https://privacy.xboxlive.com/users/me/permission/validate").map_err(|_| "chat-privacy-url")?;
+        url.query_pairs_mut().append_pair("setting", "CommunicateUsingText").append_pair("target", &format!("xuid({peer})"));
+        let request = self.client.get(url).header("Authorization", &self.authorization)
+            .header("X-RequestedServiceVersion", "1").header("x-xbl-contract-version", "1");
+        let value = response(signed(request, &mut self.signer).await?.send().await.map_err(|_| "chat-privacy-request")?, "chat-privacy-http", false).await?;
+        if value["isAllowed"] != true { return Err("privacy-or-access-denied"); }
+        Ok(())
+    }
+
+    async fn post(&mut self, request: RequestBuilder) -> Result<Value, &'static str> {
+        let request = request.header("Authorization", &self.authorization).header("Accept-Language", "en-US");
+        response(signed(request, &mut self.signer).await?.send().await.map_err(|_| "request-unconfirmed")?, "send-http", true).await
+    }
+}
+
+fn receipt(value: &Value) -> Result<Value, &'static str> {
+    if !value["error"].is_null() || !value["errors"].is_null() { return Err("send-unconfirmed"); }
+    let id = value["messageId"].as_str().filter(|s| !s.trim().is_empty() && s.len() <= 256
+        && !s.chars().any(char::is_control)).ok_or("send-unconfirmed")?;
+    Ok(json!({"id":id}))
+}
+
+pub(super) async fn send(tokens: &TokenManager, expected: &str, peer: &str, message: &str) -> Result<Value, &'static str> {
+    let mut session = Session::new(tokens, expected).await?;
+    session.allowed(peer).await?;
+    account_unchanged(tokens, &session.account, &session.principal)?;
+    let request = super::send_builder(&session.client, peer, message);
+    let value = session.post(request).await?;
+    account_unchanged(tokens, &session.account, &session.principal)?;
+    Ok(json!({"schema":1,"kind":"sent","account":session.account,"items":[receipt(&value)?]}))
+}
