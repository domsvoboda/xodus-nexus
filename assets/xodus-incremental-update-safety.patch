--- /dev/null
+++ b/crates/xodus-cli/src/installation_state.rs
@@ -0,0 +1,198 @@
+//! Durable update barrier, independent of launcher queue/history state.
+use std::{fs::{self, File, OpenOptions}, io::{self, Read, Write}, path::Path};
+use std::os::unix::fs::OpenOptionsExt;
+
+pub(crate) const INCOMPLETE: &str = ".nexus-update-incomplete-v1";
+const LOCK: &str = ".nexus-streaming.lock";
+
+pub(crate) fn incomplete(root: &Path) -> io::Result<bool> {
+    match fs::symlink_metadata(root.join(INCOMPLETE)) {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
+
+pub(crate) fn ensure_ready(root: &Path) -> io::Result<()> {
+    if incomplete(root)? {
+        return Err(io::Error::other("An update was interrupted. Resume the update before playing."));
+    }
+    Ok(())
+}
+
+fn no_follow(options: &mut OpenOptions) -> &mut OpenOptions {
+    options.custom_flags((rustix::fs::OFlags::NOFOLLOW | rustix::fs::OFlags::NONBLOCK).bits() as i32)
+}
+
+/// Hold the same installation lock as streaming, shared for a running game.
+/// Read-only installations remain launchable, but never bypass an existing lock.
+pub(crate) fn launch_guard(root: &Path) -> io::Result<Option<File>> {
+    launch_guard_with(root, fs2::FileExt::try_lock_shared)
+}
+
+fn launch_guard_with(root: &Path, shared_lock: impl FnOnce(&File) -> io::Result<()>) -> io::Result<Option<File>> {
+    ensure_ready(root)?;
+    let path = root.join(LOCK);
+    let file = match no_follow(OpenOptions::new().read(true).write(true).create(true).truncate(false).mode(0o600)).open(&path) {
+        Ok(file) => Some(file),
+        Err(error) if matches!(error.kind(), io::ErrorKind::PermissionDenied | io::ErrorKind::ReadOnlyFilesystem) => {
+            match no_follow(OpenOptions::new().read(true)).open(&path) {
+                Ok(file) => Some(file),
+                Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+                Err(error) => return Err(error),
+            }
+        }
+        Err(error) => return Err(error),
+    };
+    if let Some(file) = &file {
+        if !file.metadata()?.is_file() { return Err(io::Error::other("invalid installation lock")); }
+        if let Err(error) = shared_lock(file) {
+            if error.kind() == io::ErrorKind::Unsupported || matches!(error.raw_os_error(), Some(nix::libc::EOPNOTSUPP | nix::libc::ENOSYS)) {
+                // Existing read-only/unsupported volumes must remain usable.
+                // Streaming itself already requires an exclusive folder lock.
+                ensure_ready(root)?;
+                return Ok(None);
+            }
+            return Err(io::Error::other("Finish this game's installation before playing it."));
+        }
+        let flags = rustix::io::fcntl_getfd(file)?;
+        rustix::io::fcntl_setfd(file, flags - rustix::io::FdFlags::CLOEXEC)?;
+    }
+    ensure_ready(root)?;
+    Ok(file)
+}
+
+/// Sync this barrier before the first in-place file replacement. Do not remove
+/// it on error/cancel/process death, even if the queue entry is later deleted.
+pub(crate) fn begin(root: &Path) -> io::Result<()> {
+    begin_with_placeholders(root, &[])
+}
+
+pub(crate) fn begin_with_placeholders(root: &Path, placeholders: &[String]) -> io::Result<()> {
+    let path = root.join(INCOMPLETE);
+    let mut file = match no_follow(OpenOptions::new().write(true).create_new(true).mode(0o600)).open(&path) {
+        Ok(mut file) => {
+            let bytes = serde_json::to_vec(&serde_json::json!({"schema":1,"placeholders":placeholders}))?;
+            if bytes.len() > 4 * 1024 * 1024 { return Err(io::Error::other("update placeholder snapshot is too large")); }
+            file.write_all(&bytes)?;
+            file
+        }
+        Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {
+            no_follow(OpenOptions::new().read(true)).open(&path)?
+        }
+        Err(error) => return Err(error),
+    };
+    if !file.metadata()?.is_file() { return Err(io::Error::other("invalid incomplete-update marker")); }
+    file.flush()?;
+    file.sync_all()?;
+    File::open(root)?.sync_all()
+}
+
+pub(crate) fn placeholders(root: &Path) -> io::Result<std::collections::HashSet<String>> {
+    let file = no_follow(OpenOptions::new().read(true)).open(root.join(INCOMPLETE))?;
+    if !file.metadata()?.is_file() { return Err(io::Error::other("invalid incomplete-update marker")); }
+    let mut bytes = Vec::new();
+    file.take(4 * 1024 * 1024 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > 4 * 1024 * 1024 { return Ok(Default::default()); }
+    let Ok(value) = serde_json::from_slice::<serde_json::Value>(&bytes) else { return Ok(Default::default()); };
+    if value["schema"] != 1 { return Ok(Default::default()); }
+    Ok(value["placeholders"].as_array().into_iter().flatten()
+        .filter_map(|name| name.as_str().map(str::to_owned)).collect())
+}
+
+/// Publish and sync the new package metadata before allowing any game launch.
+pub(crate) fn finish(root: &Path, cache: &Path, final_path: &Path) -> io::Result<()> {
+    let file = no_follow(OpenOptions::new().read(true)).open(cache)?;
+    if !file.metadata()?.is_file() { return Err(io::Error::other("invalid package metadata")); }
+    file.sync_all()?;
+    fs::rename(cache, final_path)?;
+    File::open(root)?.sync_all()?;
+    if incomplete(root)? {
+        fs::remove_file(root.join(INCOMPLETE))?;
+        File::open(root)?.sync_all()?;
+    }
+    Ok(())
+}
