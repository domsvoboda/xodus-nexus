+    #[test]
+    fn streaming_update_launch_preserves_read_only_and_unsupported_lock_installations() {
+        use std::os::unix::fs::PermissionsExt;
+        let root = tempfile::tempdir().unwrap();
+        fs::set_permissions(root.path(), fs::Permissions::from_mode(0o555)).unwrap();
+        assert!(launch_guard(root.path()).is_ok());
+        fs::set_permissions(root.path(), fs::Permissions::from_mode(0o755)).unwrap();
+        for errno in [nix::libc::EOPNOTSUPP, nix::libc::ENOSYS] {
+            assert!(launch_guard_with(root.path(), |_| Err(io::Error::from_raw_os_error(errno))).unwrap().is_none());
+        }
+        assert!(launch_guard_with(root.path(), |_| Err(io::ErrorKind::WouldBlock.into())).is_err());
+        begin(root.path()).unwrap();
+        assert!(launch_guard_with(root.path(), |_| Err(io::ErrorKind::Unsupported.into())).is_err());
+    }
+
+    #[tokio::test]
+    async fn streaming_update_actual_run_refuses_incomplete_installation_before_game_or_account_access() {
+        let root = tempfile::tempdir().unwrap();
+        begin(root.path()).unwrap();
+        let result = crate::commands::run::run(&reqwest::Client::new(), &xodus::tokens::TokenManager::with_memory(),
+            root.path().to_string_lossy().into_owned(), "/must-not-run".into(), None, false, false, None).await;
+        assert_eq!(result, std::process::ExitCode::FAILURE);
+    }
+
+    #[test]
+    fn streaming_update_cli_advertises_the_real_recovery_contract_before_authentication() {
+        use clap::CommandFactory;
+        let mut command = crate::CliArgs::command();
+        let help = command.find_subcommand_mut("streaming").unwrap().render_help().to_string();
+        assert!(help.lines().any(|line| line == "Nexus capabilities: update-recovery-v1"));
+    }
