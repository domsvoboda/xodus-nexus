+#[cfg(test)]
+mod credential_player_identity_tests {
+    use super::*;
+
+    fn account(name: &str) -> (User, HashMap<String, Token>) {
+        (
+            User { puid: format!("puid-{name}"), username: name.into() },
+            HashMap::from([(PASSPORT_STS.into(), Token::Compact(format!("ticket-{name}")))]),
+        )
+    }
+
+    fn ticket(token: Token) -> String {
+        match token {
+            Token::Compact(value) => value,
+            _ => panic!("unexpected token kind"),
+        }
+    }
+
+    #[test]
+    fn without_a_player_both_identities_are_the_license_account() {
+        let manager = TokenManager::with_memory();
+        let (user, tokens) = account("owner");
+        manager.save_user_session(user, tokens).unwrap();
+        assert_eq!(manager.get_user().unwrap().username, "owner");
+        assert_eq!(manager.get_license_user().unwrap().username, "owner");
+        assert!(manager.get_player_user().unwrap().is_none());
+    }
+
+    #[test]
+    fn the_player_answers_for_xbox_and_the_owner_for_licenses() {
+        let manager = TokenManager::with_memory();
+        let (user, tokens) = account("owner");
+        manager.save_user_session(user, tokens).unwrap();
+        let (user, tokens) = account("player");
+        manager.save_player_session(user, tokens).unwrap();
+        assert_eq!(manager.get_user().unwrap().username, "player");
+        assert_eq!(manager.get_license_user().unwrap().username, "owner");
+        assert_eq!(manager.get_player_user().unwrap().unwrap().username, "player");
+        assert_eq!(ticket(manager.get_user_sts_token().unwrap()), "ticket-player");
+        assert_eq!(ticket(manager.get_license_sts_token().unwrap()), "ticket-owner");
+        let (user, token) = manager.get_license_sts_session().unwrap().unwrap();
+        assert_eq!((user.username.as_str(), ticket(token).as_str()), ("owner", "ticket-owner"));
+    }
+
+    #[test]
+    fn a_renewed_ticket_goes_back_to_the_session_it_was_read_from() {
+        let manager = TokenManager::with_memory();
+        let (user, tokens) = account("owner");
+        manager.save_user_session(user, tokens).unwrap();
+        let (user, tokens) = account("player");
+        manager.save_player_session(user, tokens).unwrap();
+        manager
+            .save_user_token(PASSPORT_STS.into(), Token::Compact("renewed".into()))
+            .unwrap();
+        assert_eq!(ticket(manager.get_user_sts_token().unwrap()), "renewed");
+        assert_eq!(ticket(manager.get_license_sts_token().unwrap()), "ticket-owner");
+    }
+
+    #[test]
+    fn signing_out_one_account_keeps_the_other() {
+        let manager = TokenManager::with_memory();
+        let (user, tokens) = account("owner");
+        manager.save_user_session(user, tokens).unwrap();
+        let (user, tokens) = account("player");
+        manager.save_player_session(user, tokens).unwrap();
+        manager.remove_player().unwrap();
+        assert!(manager.get_player_user().unwrap().is_none());
+        assert_eq!(manager.get_user().unwrap().username, "owner");
+        let (user, tokens) = account("player");
+        manager.save_player_session(user, tokens).unwrap();
+        manager.remove_persistent().unwrap();
+        assert!(manager.get_license_user().is_err());
+        assert_eq!(manager.get_player_user().unwrap().unwrap().username, "player");
+    }
+
+    #[test]
+    fn a_player_without_a_license_account_has_no_license_identity() {
+        let manager = TokenManager::with_memory();
+        let (user, tokens) = account("player");
+        manager.save_player_session(user, tokens).unwrap();
+        assert!(manager.get_license_sts_token().is_err());
+        assert_eq!(manager.get_user().unwrap().username, "player");
+    }
+
+    #[test]
+    fn a_player_session_needs_a_real_account_and_tickets() {
+        let manager = TokenManager::with_memory();
+        let (_, tokens) = account("player");
+        assert!(manager
+            .save_player_session(User { puid: "x".into(), username: " ".into() }, tokens)
+            .is_err());
+        let (user, _) = account("player");
+        assert!(manager.save_player_session(user, HashMap::new()).is_err());
+        assert!(manager.get_player_user().unwrap().is_none());
+    }
+}
