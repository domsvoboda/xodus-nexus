+/// subscription (Store ticket, library, membership). Without a separate player
+/// account both are the same account.
+#[derive(Clone, Copy)]
+pub enum Role {
+    License,
+    Xbox,
+}
+
+impl Role {
+    fn user(self, tokens: &TokenManager) -> Result<xodus::models::secrets::User, xodus::tokens::store::TokenStoreError> {
+        match self {
+            Role::License => tokens.get_license_user(),
+            Role::Xbox => tokens.get_user(),
+        }
+    }
+
+    fn token(self, tokens: &TokenManager) -> Result<Token, xodus::tokens::store::TokenStoreError> {
+        match self {
+            Role::License => tokens.get_license_sts_token(),
+            Role::Xbox => tokens.get_user_sts_token(),
+        }
+    }
