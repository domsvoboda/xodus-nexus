+#[cfg(test)]
+mod credential_saved_accounts_tests {
+    use super::*;
+    fn save(m: &TokenManager, name: &str) {
+        m.save_user_session(User { puid: name.into(), username: name.into() },
+            HashMap::from([(PASSPORT_STS.into(), Token::Compact(format!("ticket-{name}")))])).unwrap();
+    }
+    #[test]
+    fn credential_saved_accounts_keep_every_signed_in_license_account() {
+        let m = TokenManager::with_memory();
+        save(&m, "castlevania"); save(&m, "gamepass");
+        assert_eq!(m.saved_accounts().unwrap(), vec!["castlevania".to_string(), "gamepass".to_string()]);
+        assert_eq!(m.get_license_user().unwrap().username, "gamepass");
+    }
+    #[test]
+    fn credential_saved_accounts_switch_without_losing_the_previous_one() {
+        let m = TokenManager::with_memory();
+        save(&m, "castlevania"); save(&m, "gamepass");
+        m.activate_saved_account("castlevania").unwrap();
+        assert_eq!(m.get_license_user().unwrap().username, "castlevania");
+        m.activate_saved_account("gamepass").unwrap();
+        assert_eq!(m.get_license_user().unwrap().username, "gamepass");
+        assert_eq!(m.saved_accounts().unwrap().len(), 2);
+        assert!(m.activate_saved_account("missing").is_err());
+    }
+    #[test]
+    fn credential_saved_accounts_survive_sign_out_and_can_be_forgotten() {
+        let m = TokenManager::with_memory();
+        save(&m, "castlevania");
+        m.remove_persistent().unwrap();
+        assert!(m.get_license_user().is_err());
+        assert_eq!(m.saved_accounts().unwrap(), vec!["castlevania".to_string()]);
+        m.activate_saved_account("castlevania").unwrap();
+        m.forget_saved_account("castlevania").unwrap();
+        assert!(m.saved_accounts().unwrap().is_empty());
+        assert!(m.get_license_user().is_err());
+    }
