+// Devices without firmware DMI data (most ARM boards) have no table. Do not
+// ask for elevation there: the read can only fail after the password prompt.
+#[cfg(target_os = "linux")]
+fn load_raw_smbios_from(table: &std::path::Path) -> io::Result<Vec<u8>> {
+    if !table.exists() {
+        return Err(io::Error::new(
+            io::ErrorKind::NotFound,
+            "no SMBIOS system table on this device",
+        ));
+    }
     let cmd = Command::new("pkexec")
-        .args(["cat", "/sys/firmware/dmi/entries/1-0/raw"])
+        .arg("cat")
+        .arg(table)
         .stdout(Stdio::piped())
         .spawn()?;
     let output = cmd.wait_with_output()?;
