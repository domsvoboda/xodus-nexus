+/// Reports the failing stage (a fixed, secret-free slug) so the launcher can show why
+/// the list did not load, instead of a bare failure.
+fn fail(stage: &str, json_output: bool) -> ExitCode {
+    eprintln!("Xbox achievements unavailable: {stage}");
+    if json_output { println!("{}", json!({"schema":1,"error":stage})); }
+    ExitCode::FAILURE
+}
