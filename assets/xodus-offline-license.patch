index 0000000..6b0ba6f
--- /dev/null
+++ b/crates/xodus-cli/src/commands/offline_pc.rs
@@ -0,0 +1,125 @@
+//! Experimental probe for the Xbox app's "offline permissions" setting.
+//!
+//! The Xbox PC app reads and changes the account's designated offline PC
+//! through the PC Game App Front Door:
+//!   GET  https://beige.xboxservices.com/pcgafd/config/offlinepc
+//!   POST https://beige.xboxservices.com/pcgafd/config/offlinepc/{true|false}
+//! authenticated with an XSTS token that carries device, title and user
+//! claims. Changing the setting is limited by Microsoft to a few times per
+//! year, so the write path requires an explicit confirmation flag.
+use std::process::ExitCode;
+
+use xodus::tokens::TokenManager;
+use base64::{Engine, prelude::BASE64_STANDARD};
+
+const ENDPOINT: &str = "https://beige.xboxservices.com/pcgafd/config/offlinepc";
+// Same client identity Xodus uses for its Xbox sign-in flows.
+const CLIENT_ID: &str = "000000004424da1f";
+const TITLE_ID: i64 = 704208617;
+const MAX_BODY: usize = 64 * 1024;
+
+pub async fn run(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    set: Option<bool>,
+    confirm: bool,
+    relying_party: String,
+) -> ExitCode {
+    if set.is_some() && !confirm {
+        eprintln!(
+            "Refusing to change the offline PC designation without --confirm: Microsoft allows only a few changes per year and designating this device un-designates any other."
+        );
+        return ExitCode::FAILURE;
+    }
+    // Device-bound Xbox sign-in: device token + title token + user token -> XSTS.
+    let (_authenticator, sisu, device) =
+        match xodus::auth::do_sisu(client, tokens, CLIENT_ID, TITLE_ID).await {
+            Ok(result) => result,
+            Err(error) => {
+                eprintln!("Xbox device sign-in for the offline-permission request failed: {error}");
+                return ExitCode::FAILURE;
+            }
+        };
+    let xsts = if relying_party == "http://xboxlive.com" {
+        sisu.authorization_token.clone()
+    } else {
+        match xodus::auth::get_xsts_token(
+            Some(&device),
+            Some(&sisu.title_token),
+            Some(&sisu.user_token),
+            &relying_party,
+        )
+        .await
+        {
+            Ok(token) => token,
+            Err(error) => {
+                eprintln!("XSTS request for relying party {relying_party} failed: {error}");
+                return ExitCode::FAILURE;
+            }
+        }
+    };
+    let claims = xsts
+        .display_claims
+        .as_ref()
+        .map(|claims| {
+            claims
+                .xui
+                .iter()
+                .flat_map(|claim| claim.keys().cloned())
+                .collect::<Vec<_>>()
+                .join(",")
+        })
+        .unwrap_or_default();
+    eprintln!(
+        "Relying party {relying_party}: XSTS valid until {} with claim keys [{claims}]; device token valid until {}.",
+        xsts.not_after, device.not_after
+    );
+    let authorization = xsts.authorization_header_value();
+
+    let correlation = format!("{}.0", BASE64_STANDARD.encode(uuid::Uuid::new_v4().as_bytes()).trim_end_matches("="));
+    let request = match set {
+        None => client.get(ENDPOINT),
+        Some(value) => client.post(format!("{ENDPOINT}/{value}")).header("Content-Length", "0"),
+    };
+    let response = request
+        .header("Authorization", authorization)
+        .header("Accept", "application/json")
+        .header("Accept-Language", "en-US")
+        .header("X-MS-API-Version", "1.0")
+        .header("x-xbl-contract-version", "1")
+        .header("MS-CV", correlation.as_str())
+        .timeout(std::time::Duration::from_secs(30))
+        .send()
+        .await;
+    let response = match response {
+        Ok(response) => response,
+        Err(error) => {
+            eprintln!("Offline-permission request failed: {error}");
+            return ExitCode::FAILURE;
+        }
+    };
+    let status = response.status();
+    let headers: Vec<String> = response
+        .headers()
+        .iter()
+        .filter(|(name, _)| {
+            let name = name.as_str();
+            name.starts_with("x-") || name == "content-type" || name == "ms-cv" || name == "retry-after" || name == "www-authenticate"
+        })
+        .map(|(name, value)| format!("{name}: {}", value.to_str().unwrap_or("<binary>")))
+        .collect();
+    let body = match response.bytes().await {
+        Ok(bytes) => bytes,
+        Err(error) => {
+            eprintln!("Offline-permission response could not be read: {error}");
+            return ExitCode::FAILURE;
+        }
+    };
+    let shown = String::from_utf8_lossy(&body[..body.len().min(MAX_BODY)]);
+    println!("HTTP {status}");
+    for header in headers {
+        println!("{header}");
+    }
+    println!("{shown}");
+    if status.is_success() { ExitCode::SUCCESS } else { ExitCode::FAILURE }
+}
