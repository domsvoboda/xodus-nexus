+/* Native XAsync keeps the operation alive while its completion callback is
+ * queued or running: provider Cleanup requested by GetResult inside that
+ * callback runs only after it returns. Titles may close a result handle
+ * before reading data the provider context still owns (007 First Light). */
+static BOOL async_completion_pending( const struct async_state *state )
+{
+    return state->completed && state->callback && !state->completion_finished;
+}
