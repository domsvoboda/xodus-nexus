 static void async_cleanup_state( struct async_state *state, XAsyncProvider *provider )
 {
     BOOL cleanup = FALSE;
     EnterCriticalSection( &state->cs );
     state->cleanup_requested = TRUE;
-    if (!state->active_provider && !state->cleaned)
+    if (!state->active_provider && !state->cleaned && !async_completion_pending( state ))
     {
         state->cleaned = 1;
         cleanup = TRUE;
@@ -322,7 +331,7 @@ static HRESULT async_invoke_provider( struct async_state *state, XAsyncOp op )
     LeaveCriticalSection( &state->cs );
     hr = state->provider( op, &state->data );
     EnterCriticalSection( &state->cs );
-    if (!--state->active_provider && state->cleanup_requested && !state->cleaned)
+    if (!--state->active_provider && state->cleanup_requested && !state->cleaned && !async_completion_pending( state ))
     {
         state->cleaned = 1;
         cleanup = TRUE;
