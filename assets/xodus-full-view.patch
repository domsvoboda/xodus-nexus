+// Copies one decrypted image as is. Unlike the launch stub writer it accepts
+// encrypted files that are not PE images, which a full view must also contain.
+fn copy_decrypted_image(path: &Path, fd: RawFd) -> std::io::Result<u64> {
+    // Borrow the decrypted memfd without taking ownership; it is closed with the image.
+    let image = std::mem::ManuallyDrop::new(unsafe { std::fs::File::from_raw_fd(fd) });
+    let image_len = image.metadata()?.len();
+    let output = std::fs::OpenOptions::new().write(true).create_new(true).open(path)?;
+    let mut buffer = vec![0u8; 1024 * 1024];
+    let mut offset = 0u64;
+    while offset < image_len {
+        let bytes = (image_len - offset).min(buffer.len() as u64) as usize;
+        image.read_exact_at(&mut buffer[..bytes], offset)?;
+        output.write_all_at(&buffer[..bytes], offset)?;
+        offset += bytes as u64;
+    }
+    output.set_permissions(std::fs::Permissions::from_mode(0o700))?;
+    Ok(image_len)
+}
