+#[test]
+fn offline_license_entries_list_only_this_accounts_valid_licenses_with_their_market() {
+    let root = tempfile::tempdir().unwrap();
+    let cache = LicenseCache::new(root.path());
+    assert!(cache.entries("puid", NOW).is_empty(), "a missing cache directory lists nothing");
+    cache.store("content-b", "puid", "DE", &license("YmxvY2s="), Some(NOW + 9 * DAY), NOW).unwrap();
+    cache.store("content-a", "puid", "US", &license("YmxvY2s="), Some(NOW + 20 * DAY), NOW).unwrap();
+    cache.store("content-c", "other", "US", &license("YmxvY2s="), Some(NOW + 20 * DAY), NOW).unwrap();
+    cache.store("content-d", "puid", "US", &license("YmxvY2s="), Some(NOW + DAY), NOW).unwrap();
+    std::fs::write(root.path().join("content-e.json.tmp"), b"partial").unwrap();
+    std::fs::write(root.path().join("notes.txt"), b"ignored").unwrap();
+
+    let listed = cache.entries("puid", NOW + 2 * DAY);
+    let summary: Vec<(&str, &str, u64)> = listed
+        .iter()
+        .map(|(id, entry)| (id.as_str(), entry.market.as_str(), entry.expires_at))
+        .collect();
+    assert_eq!(summary, vec![("content-a", "US", NOW + 20 * DAY), ("content-b", "DE", NOW + 9 * DAY)]);
+    // The expired entry was removed; the other account's entry and unrelated files stay.
+    assert!(!root.path().join("content-d.json").exists());
+    assert!(root.path().join("content-c.json").exists());
+    assert!(root.path().join("content-e.json.tmp").exists());
+}
