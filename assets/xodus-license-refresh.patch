+/// What renewing one stored offline license produced.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Renewal {
+    /// Microsoft issued a new offline lease; the entry is valid until then (Unix seconds).
+    Renewed(u64),
+    /// Microsoft issued the license without an offline lease, so the entry was
+    /// removed (this device is no longer the designated offline device).
+    OnlineOnly,
+    /// Microsoft could not be reached; the entry is unchanged.
+    Unreachable,
+    /// Microsoft refused this account or content; the entry was removed.
+    Refused,
+    /// Sign-in, credential or response problems; the entry is unchanged.
+    Failed,
+}
+
+/// Renews the signed-in account's stored offline licenses online, so games
+/// that were not launched while online keep offline permission. Stops at the
+/// first unreachable answer instead of waiting out every request's timeout.
+pub async fn refresh_licenses(
+    client: &reqwest::Client,
+    tokens: &TokenManager,
+    root: &Path,
+) -> std::result::Result<Vec<(String, Renewal)>, String> {
+    let user = tokens.get_user().map_err(|error| error.to_string())?;
+    let cache = LicenseCache::new(root);
+    let mut results = Vec::new();
+    for (content_id, entry) in cache.entries(&user.puid, unix_now()) {
+        let renewal = match fetch_online(client, tokens, &user, content_id.clone(), entry.market.clone()).await {
+            Ok(license) => {
+                record_license(root, &content_id, &user.puid, &entry.market, &license);
+                match cache.load(&content_id, &user.puid, unix_now()) {
+                    Ok(Some(stored)) => Renewal::Renewed(stored.expires_at),
+                    _ => Renewal::OnlineOnly,
+                }
+            }
+            Err(OnlineFailure::Unreachable(_)) => Renewal::Unreachable,
+            Err(OnlineFailure::Refused(_)) => {
+                if cache.purge(&content_id) == Ok(true) {
+                    diagnostic("content-cache-purged");
+                }
+                Renewal::Refused
+            }
+            Err(OnlineFailure::Other(message)) => {
+                eprintln!("{message}");
+                Renewal::Failed
+            }
+        };
+        let unreachable = renewal == Renewal::Unreachable;
+        results.push((content_id, renewal));
+        if unreachable {
+            break;
+        }
+    }
+    Ok(results)
+}
