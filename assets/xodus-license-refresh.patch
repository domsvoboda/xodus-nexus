+    /// The valid entries of this account, ordered by content identifier.
+    /// Expired or unreadable entries are removed exactly as `load` removes
+    /// them; other accounts' entries are left alone.
+    pub fn entries(&self, puid: &str, now: u64) -> Vec<(String, CachedLicense)> {
+        let Ok(directory) = fs::read_dir(&self.root) else {
+            return Vec::new();
+        };
+        let mut content_ids: Vec<String> = directory
+            .filter_map(Result::ok)
+            .filter_map(|entry| {
+                entry
+                    .file_name()
+                    .to_str()
+                    .and_then(|name| name.strip_suffix(".json"))
+                    .map(str::to_string)
+            })
+            .collect();
+        content_ids.sort();
+        content_ids
+            .into_iter()
+            .filter_map(|content_id| {
+                let entry = self.load(&content_id, puid, now).ok().flatten()?;
+                Some((content_id, entry))
+            })
+            .collect()
+    }
