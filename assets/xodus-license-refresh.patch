+//! Renews the device-bound offline licenses that `run --license-cache` stored,
+//! while Microsoft is reachable. An offline lease lasts at most 30 days and
+//! was renewed only by launching that game online; the launcher runs this in
+//! the background so every cached game keeps offline permission.
+//!
+//! Output contract (stdout, one JSON line, schema 1):
+//! `{"schema":1,"checked":n,"renewed":n,"onlineOnly":n,"refused":n,"failed":n,
+//!   "unreachable":bool,"earliestExpiresAt":<Unix seconds>|null}`
+//! `earliestExpiresAt` is the soonest expiry among the renewed licenses.
+use std::path::Path;
+use std::process::ExitCode;
+
+use serde_json::{Value, json};
+use xodus::tokens::TokenManager;
+
+use crate::license::{Renewal, refresh_licenses};
+
+pub async fn run(client: &reqwest::Client, tokens: &TokenManager, license_cache: String) -> ExitCode {
+    let results = match refresh_licenses(client, tokens, Path::new(&license_cache)).await {
+        Ok(results) => results,
+        Err(error) => {
+            eprintln!("{error}");
+            return ExitCode::FAILURE;
+        }
+    };
+    let summary = summarize(&results);
+    println!("{summary}");
+    if summary["unreachable"] == true || summary["failed"] != 0 {
+        ExitCode::FAILURE
+    } else {
+        ExitCode::SUCCESS
+    }
+}
+
+fn summarize(results: &[(String, Renewal)]) -> Value {
+    let count = |wanted: fn(&Renewal) -> bool| results.iter().filter(|(_, renewal)| wanted(renewal)).count();
+    json!({
+        "schema": 1,
+        "checked": results.len(),
+        "renewed": count(|renewal| matches!(renewal, Renewal::Renewed(_))),
+        "onlineOnly": count(|renewal| *renewal == Renewal::OnlineOnly),
+        "refused": count(|renewal| *renewal == Renewal::Refused),
+        "failed": count(|renewal| *renewal == Renewal::Failed),
+        "unreachable": results.iter().any(|(_, renewal)| *renewal == Renewal::Unreachable),
+        "earliestExpiresAt": results
+            .iter()
+            .filter_map(|(_, renewal)| match renewal {
+                Renewal::Renewed(expires_at) => Some(*expires_at),
+                _ => None,
+            })
+            .min(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn license_refresh_summary_counts_outcomes_without_identifiers() {
+        let results = vec![
+            ("content-a".to_string(), Renewal::Renewed(1_900_000_000)),
+            ("content-b".to_string(), Renewal::Renewed(1_800_000_000)),
+            ("content-c".to_string(), Renewal::OnlineOnly),
+            ("content-d".to_string(), Renewal::Refused),
+            ("content-e".to_string(), Renewal::Failed),
+        ];
+        let summary = summarize(&results);
+        assert_eq!(summary["schema"], 1);
+        assert_eq!(summary["checked"], 5);
+        assert_eq!(summary["renewed"], 2);
+        assert_eq!(summary["onlineOnly"], 1);
+        assert_eq!(summary["refused"], 1);
+        assert_eq!(summary["failed"], 1);
+        assert_eq!(summary["unreachable"], false);
+        assert_eq!(summary["earliestExpiresAt"], 1_800_000_000);
+        assert!(!summary.to_string().contains("content-"));
+
+        let unreachable = summarize(&[("content-a".to_string(), Renewal::Unreachable)]);
+        assert_eq!(unreachable["unreachable"], true);
+        assert!(unreachable["earliestExpiresAt"].is_null());
+        let empty = summarize(&[]);
+        assert_eq!(empty["checked"], 0);
+        assert_eq!(empty["unreachable"], false);
+    }
+}
