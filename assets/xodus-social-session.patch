+    #[tokio::test]
+    async fn chat_session_post_is_signed_once_without_retries_redirects_or_error_payloads() {
+        for status in [200, 201, 302, 401, 403, 429, 500, 0] {
+            let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+            let address = listener.local_addr().unwrap();
+            let server = listener.try_clone().unwrap();
+            let task = thread::spawn(move || {
+                let (mut socket, _) = server.accept().unwrap(); socket.set_read_timeout(Some(std::time::Duration::from_secs(2))).unwrap();
+                let mut bytes = Vec::new(); let mut chunk = [0u8; 2048];
+                loop {
+                    let n = socket.read(&mut chunk).unwrap(); assert!(n > 0); bytes.extend_from_slice(&chunk[..n]);
+                    if let Some(end) = bytes.windows(4).position(|v| v == b"\r\n\r\n") {
+                        let headers = String::from_utf8_lossy(&bytes[..end]).to_ascii_lowercase();
+                        let len = headers.lines().find_map(|v| v.strip_prefix("content-length: ").and_then(|v| v.parse::<usize>().ok())).unwrap_or(0);
+                        if bytes.len() >= end + 4 + len { break; }
+                    }
+                    assert!(bytes.len() < 16384);
+                }
+                if status != 0 {
+                    let body = if status == 200 || status == 201 { r#"{"messageId":"synthetic-receipt","conversationId":"synthetic-thread"}"# } else { "PRIVATE_SERVER_ERROR" };
+                    write!(socket, "HTTP/1.1 {status} Test\r\nContent-Length: {}\r\nLocation: http://127.0.0.1:1/blocked\r\nConnection: close\r\n\r\n{body}", body.len()).unwrap();
+                }
+                bytes
+            });
+            let client = Client::builder().redirect(reqwest::redirect::Policy::none()).timeout(std::time::Duration::from_secs(2)).build().unwrap();
+            let mut session = Session { client, signer:policy("127.0.0.1", "http"), authorization:"SYNTHETIC_NOT_A_TOKEN".into(), account:"synthetic".into(), principal:"synthetic".into() };
+            let op = super::super::Operation::Send("42".into(), "synthetic-only".into());
+            let result = session.post(super::super::Plan { url:format!("http://{address}/fixture"), contract:"1", body:super::super::plan(&op).body }).await;
+            let captured = String::from_utf8(task.join().unwrap()).unwrap();
+            assert!(captured.starts_with("POST /fixture HTTP/1.1\r\n"));
+            let headers = captured.split_once("\r\n\r\n").unwrap().0.to_ascii_lowercase();
+            assert!(headers.contains("\r\nsignature: ")); assert!(headers.contains("\r\nauthorization: synthetic_not_a_token"));
+            assert!(headers.contains("\r\nx-xbl-contract-version: 1"));
+            assert_eq!(serde_json::from_str::<Value>(captured.split_once("\r\n\r\n").unwrap().1).unwrap(), super::super::plan(&op).body.unwrap());
+            match status { 200|201 => assert_eq!(result.unwrap()["messageId"], "synthetic-receipt"),
+                401 => assert_eq!(result.unwrap_err(), "sign-in-required"), 403 => assert_eq!(result.unwrap_err(), "privacy-or-access-denied"),
+                429 => assert_eq!(result.unwrap_err(), "rate-limited"), 0 => assert_eq!(result.unwrap_err(), "request-unconfirmed"),
+                _ => assert_eq!(result.unwrap_err(), "service-unavailable") }
+            listener.set_nonblocking(true).unwrap();
+            assert!(matches!(listener.accept(), Err(e) if e.kind() == std::io::ErrorKind::WouldBlock), "unexpected retry or redirect");
+        }
+    }
+}
