+// The runtime launcher's PlayFab staging for a full launch view, which runs
+// under any Wine: each supported SDK in a real view directory is kept as
+// nexus_pgs_native.dll and the adapter takes its name. Symlinked directories
+// belong to the game installation and are left alone.
+fn stage_playfab_adapter(directory: &Path, adapter: &[u8], depth: usize) -> std::io::Result<usize> {
+    if depth > 64 {
+        return Err(std::io::Error::other("launch view is nested too deeply"));
+    }
+    let mut staged = 0;
+    for item in std::fs::read_dir(directory)? {
+        let item = item?;
+        let kind = item.file_type()?;
+        let name = item.file_name();
+        if kind.is_dir() {
+            staged += stage_playfab_adapter(&item.path(), adapter, depth + 1)?;
+            continue;
+        }
+        if !name.to_string_lossy().eq_ignore_ascii_case("PlayFabGameSave.dll") {
+            continue;
+        }
+        let original = std::fs::read(item.path())?;
+        if !playfab_sdk_contract(&original) {
+            eprintln!("Nexus runtime: unsupported PlayFab SDK export contract; left unchanged.");
+            continue;
+        }
+        let alias = directory.join("nexus_pgs_native.dll");
+        match std::fs::symlink_metadata(&alias) {
+            Ok(_) => {
+                // Only an earlier staging of this same adapter may be there already.
+                if !playfab_sdk_contract(&std::fs::read(&alias)?) || original != adapter {
+                    return Err(std::io::Error::other("nexus_pgs_native.dll already exists beside an unstaged PlayFab SDK"));
+                }
+            }
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => {
+                replace_view_entry(directory, "nexus_pgs_native.dll", &original)?;
+                replace_view_entry(directory, &name.to_string_lossy(), adapter)?;
+            }
+            Err(err) => return Err(err),
+        }
+        staged += 1;
+    }
+    Ok(staged)
+}
