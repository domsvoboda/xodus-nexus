+    // A minimal x64 PE whose export directory lists `names` (ordinal i -> name i).
+    fn fake_sdk(names: &[&str]) -> Vec<u8> {
+        let mut image = vec![0u8; 0x2000];
+        image[..2].copy_from_slice(b"MZ");
+        image[0x3c..0x40].copy_from_slice(&0x80u32.to_le_bytes());
+        image[0x80..0x84].copy_from_slice(b"PE\0\0");
+        image[0x84..0x86].copy_from_slice(&0x8664u16.to_le_bytes());
+        image[0x86..0x88].copy_from_slice(&1u16.to_le_bytes());
+        image[0x94..0x96].copy_from_slice(&0xf0u16.to_le_bytes());
+        let optional = 0x98;
+        image[optional..optional + 2].copy_from_slice(&0x20bu16.to_le_bytes());
+        image[optional + 108..optional + 112].copy_from_slice(&16u32.to_le_bytes());
+        image[optional + 112..optional + 116].copy_from_slice(&0x1000u32.to_le_bytes());
+        let section = optional + 0xf0;
+        image[section + 12..section + 16].copy_from_slice(&0x1000u32.to_le_bytes());
+        image[section + 16..section + 20].copy_from_slice(&0x1c00u32.to_le_bytes());
+        image[section + 20..section + 24].copy_from_slice(&0x400u32.to_le_bytes());
+        let file = |rva: u32| (rva - 0x1000 + 0x400) as usize;
+        let put = |image: &mut Vec<u8>, at: usize, value: u32| image[at..at + 4].copy_from_slice(&value.to_le_bytes());
+        let exports = file(0x1000);
+        put(&mut image, exports + 16, 1);
+        put(&mut image, exports + 20, names.len() as u32);
+        put(&mut image, exports + 24, names.len() as u32);
+        put(&mut image, exports + 28, 0x1028);
+        put(&mut image, exports + 32, 0x10c8);
+        put(&mut image, exports + 36, 0x1168);
+        let mut text = 0x1200u32;
+        for (index, name) in names.iter().enumerate() {
+            put(&mut image, file(0x1028) + index * 4, 0x1000);
+            put(&mut image, file(0x10c8) + index * 4, text);
+            image[file(0x1168) + index * 2..file(0x1168) + index * 2 + 2].copy_from_slice(&(index as u16).to_le_bytes());
+            image[file(text)..file(text) + name.len()].copy_from_slice(name.as_bytes());
+            text += name.len() as u32 + 1;
+        }
+        image
+    }
