+    #[test]
+    fn playfab_adapter_is_staged_in_real_view_directories_without_touching_the_game() {
+        let root = tempfile::tempdir().unwrap();
+        let game = root.path().join("game");
+        std::fs::create_dir_all(game.join("Shared")).unwrap();
+        let sdk = fake_sdk(&PLAYFAB_SDK_EXPORTS);
+        std::fs::write(game.join("PlayFabGameSave.dll"), &sdk).unwrap();
+        std::fs::write(game.join("Shared/PlayFabGameSave.dll"), &sdk).unwrap();
+        let view = root.path().join("view");
+        std::fs::create_dir(&view).unwrap();
+        symlink(game.join("PlayFabGameSave.dll"), view.join("PlayFabGameSave.dll")).unwrap();
+        symlink(game.join("Shared"), view.join("Shared")).unwrap();
+        let adapter = b"nexus adapter".to_vec();
+
+        assert_eq!(stage_playfab_adapter(&view, &adapter, 0).unwrap(), 1);
+        assert_eq!(std::fs::read(view.join("PlayFabGameSave.dll")).unwrap(), adapter);
+        assert!(!std::fs::symlink_metadata(view.join("PlayFabGameSave.dll")).unwrap().file_type().is_symlink());
+        assert_eq!(std::fs::read(view.join("nexus_pgs_native.dll")).unwrap(), sdk);
+        assert_eq!(std::fs::read(game.join("PlayFabGameSave.dll")).unwrap(), sdk);
+        assert_eq!(std::fs::read(game.join("Shared/PlayFabGameSave.dll")).unwrap(), sdk);
+        assert!(std::fs::read_dir(&game).unwrap().all(|item| item.unwrap().file_name() != "nexus_pgs_native.dll"));
+
+        // An unknown SDK stays as it is; a stray alias beside a real SDK is refused.
+        let other = root.path().join("other");
+        std::fs::create_dir(&other).unwrap();
+        std::fs::write(other.join("playfabgamesave.dll"), fake_pe()).unwrap();
+        assert_eq!(stage_playfab_adapter(&other, &adapter, 0).unwrap(), 0);
+        std::fs::write(other.join("PlayFabGameSave.dll"), &sdk).unwrap();
+        std::fs::write(other.join("nexus_pgs_native.dll"), &sdk).unwrap();
+        std::fs::remove_file(other.join("playfabgamesave.dll")).unwrap();
+        assert!(stage_playfab_adapter(&other, &adapter, 0).is_err());
+    }
