+fn le16(image: &[u8], at: usize) -> Option<u16> {
+    image.get(at..at.checked_add(2)?).map(|b| u16::from_le_bytes([b[0], b[1]]))
+}
+
+fn le32(image: &[u8], at: usize) -> Option<u32> {
+    image.get(at..at.checked_add(4)?).map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+// File offset of `length` bytes at `address`, inside one section's raw data.
+fn pe_offset(image: &[u8], sections: usize, count: usize, address: u32, length: usize) -> Option<usize> {
+    for index in 0..count {
+        let section = sections + index * 40;
+        let (start, raw, offset) = (le32(image, section + 12)?, le32(image, section + 16)? as usize, le32(image, section + 20)? as usize);
+        if address < start {
+            continue;
+        }
+        let within = (address - start) as usize;
+        if within <= raw && length <= raw - within && offset <= image.len() && raw <= image.len() - offset {
+            return Some(offset + within);
+        }
+    }
+    None
+}
+
+// Fail closed, like the runtime's launcher: only the exact x64 SDK export
+// contract the adapter forwards; unknown exports must not vanish behind it.
+fn playfab_sdk_contract(image: &[u8]) -> bool {
+    let check = || -> Option<bool> {
+        if image.len() < 256 || image.len() > 268_435_456 || le16(image, 0)? != 0x5a4d {
+            return Some(false);
+        }
+        let pe = le32(image, 60)? as usize;
+        if image.get(pe..pe.checked_add(4)?)? != b"PE\0\0" || le16(image, pe + 4)? != 0x8664 {
+            return Some(false);
+        }
+        let optional = pe + 24;
+        let (count, size) = (le16(image, pe + 6)? as usize, le16(image, pe + 20)? as usize);
+        let sections = optional + size;
+        if size < 120 || sections > image.len() || le16(image, optional)? != 0x20b || le32(image, optional + 108)? < 1
+            || sections + count * 40 > image.len() {
+            return Some(false);
+        }
+        let exports = pe_offset(image, sections, count, le32(image, optional + 112)?, 40)?;
+        let total = PLAYFAB_SDK_EXPORTS.len() as u32;
+        if le32(image, exports + 20)? != total || le32(image, exports + 24)? != total || le32(image, exports + 16)? != 1 {
+            return Some(false);
+        }
+        let names = pe_offset(image, sections, count, le32(image, exports + 32)?, PLAYFAB_SDK_EXPORTS.len() * 4)?;
+        let ordinals = pe_offset(image, sections, count, le32(image, exports + 36)?, PLAYFAB_SDK_EXPORTS.len() * 2)?;
+        let functions = pe_offset(image, sections, count, le32(image, exports + 28)?, PLAYFAB_SDK_EXPORTS.len() * 4)?;
+        for (index, expected) in PLAYFAB_SDK_EXPORTS.iter().enumerate() {
+            let name = pe_offset(image, sections, count, le32(image, names + index * 4)?, expected.len() + 1)?;
+            if &image[name..name + expected.len()] != expected.as_bytes() || image[name + expected.len()] != 0
+                || le16(image, ordinals + index * 2)? as usize != index || le32(image, functions + index * 4)? == 0 {
+                return Some(false);
+            }
+        }
+        Some(true)
+    };
+    check().unwrap_or(false)
+}
